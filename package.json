{
  "name": "pubky-backup-ui",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run test:run && tsc && vite build",
    "type-check": "tsc --noEmit",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1"
  },
  "devDependencies": {
    "@vitest/ui": "^4.0.16",
    "happy-dom": "^20.0.11",
    "prettier": "^3.2.5",
    "typescript": "^5.6.3",
    "vite": "^6.0.1",
    "vitest": "^4.0.16"
  }
}
